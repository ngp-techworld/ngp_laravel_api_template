# Copy to .env and fill in. Never commit .env. Values here are safe placeholders.

# --- Application --------------------------------------------------------------
# Rename APP_NAME per product. Generate APP_KEY with `php artisan key:generate`.
APP_NAME="NGP Starter API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Old keys (comma separated) while rotating APP_KEY.
APP_PREVIOUS_KEYS=

# --- Language -----------------------------------------------------------------
# Default response language; clients pick another supported one with Accept-Language.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Maintenance mode ---------------------------------------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# --- Local server (`php artisan serve`) -----------------------------------------
# More than one worker, so the SPA's parallel requests don't queue up.
PHP_CLI_SERVER_WORKERS=4

# --- Security -----------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# PostgreSQL everywhere (local, tests, CI, production).
# Tests run on the "app_test" database (phpunit.xml). Create both databases.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# --- Sessions (SPA cookie sign-in) --------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in every HTTPS environment (staging, production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Sanctum ------------------------------------------------------------------
# Hosts (with port) that use cookie (SPA) sign-in, comma separated. Only the
# React dashboard; bearer-token clients (Next.js, mobile) must not be listed.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Bearer token lifetime in minutes (43200 = 30 days).
SANCTUM_TOKEN_EXPIRATION=43200
# Optional prefix for issued tokens, so secret scanners can spot leaked ones.
SANCTUM_TOKEN_PREFIX=

# --- Cache, queue, broadcasting, files ----------------------------------------
# `database` for the MVP; Redis (+ Horizon) once there are real users.
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Redis (only when a driver above is set to redis) -------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (log locally; a real mailer on staging/production) ------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3 storage (only when FILESYSTEM_DISK=s3) --------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- API docs (Scramble, /docs/api, local only) -------------------------------
# Scramble's dev tools on the docs page; defaults to APP_DEBUG.
# SCRAMBLE_DEV_TOOLS=false
