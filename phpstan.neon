includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Start at 6 (ngp-laravel §1) and raise over time; never lower it.
    level: 6
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Framework PHPDoc is sometimes narrower than runtime (e.g. Sanctum's
    # currentAccessToken() is a TransientToken for cookie sign-ins), so don't
    # flag instanceof checks against it as always true.
    treatPhpDocTypesAsCertain: false
